# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
ENV/
env/

# Environment variables
.env
.env.*

# Generated databases
*.db
*.sqlite
*.sqlite3

# Generated output & data files (preserving directory structure via .gitkeep)
**/output/*
!**/output/.gitkeep
**/data/*
!**/data/.gitkeep

# Jupyter Notebook checkpoints
.ipynb_checkpoints/

# IDE / Editor files
.vscode/
.idea/
*.swp
*.swo
.DS_Store
